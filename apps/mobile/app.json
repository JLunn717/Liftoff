{
  "expo": {
    "name": "Liftoff",
    "slug": "liftoff",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jlunn717.liftoff"
    },
    "android": {
      "package": "com.jlunn717.liftoff",
      "googleServicesFile": "./google-services.json"
    },
    "extra": {
      "eas": {
        "projectId": "0712b14f-4ee6-4583-822b-fb1610f272b2"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#5bd1e4",
          "defaultChannel": "launch-alerts"
        }
      ]
    ]
  }
}
